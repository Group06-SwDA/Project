@startuml component-diagram-backend
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component Diagram for Backstage — App Backend

Container_Boundary(backend, "App Backend [Node.js, TypeScript]") {

    Component(backendSystem, "Backend System\n/ DI Container", "TypeScript\n@backstage/backend-app-api", "Composition root. Wires all\nplugins together by resolving\ntyped service references\n(logger, config, database,\ncache) at startup.")

    Component(catalogPlugin, "Catalog Plugin", "TypeScript\n@backstage/plugin-catalog-backend", "Ingests catalog-info.yaml\ndescriptors, processes and\nstitches entities, stores them\nin PostgreSQL, and serves the\nCatalog REST API.")

    Component(scaffolderPlugin, "Scaffolder Plugin", "TypeScript\n@backstage/plugin-scaffolder-backend", "Executes Software Template\nworkflows. Manages a task\nqueue, runs fetch/transform/\npublish actions, and persists\ntask state and logs.")

    Component(authPlugin, "Auth Plugin", "TypeScript\n@backstage/plugin-auth-backend", "Handles OAuth sign-in flows,\nmaps external identities to\ncatalog Users via\nSignInResolver, and issues\nBackstage tokens.")

    Component(techdocsPlugin, "TechDocs Plugin", "TypeScript\n@backstage/plugin-techdocs-backend", "Triggers MkDocs generation\nfor documentation-as-code\nsites and serves pre-built\nHTML assets from object\nstorage.")

    Component(searchPlugin, "Search Plugin", "TypeScript\n@backstage/plugin-search-backend", "Schedules index runs via\ncollators, stores the index,\nand serves full-text search\nqueries to the frontend.")

    Component(permissionPlugin, "Permission Plugin", "TypeScript\n@backstage/plugin-permission-backend", "Evaluates resource-level\naccess-control policies\ndefined by platform engineers\nand enforced by all other\nplugins.")
}

ContainerDb(postgres, "PostgreSQL Database", "PostgreSQL", "Durable data store.\nEach plugin owns its own\nschema with independent\nmigrations.")

Container(redis, "Cache Store", "Redis / Keyv", "Optional distributed cache.\nEach plugin uses its own\nnamespaced partition.")

Container(frontend, "Frontend SPA", "React, TypeScript", "Browser portal. Calls\nplugin REST APIs.")

System_Ext(sourceControl, "Source Control", "GitHub / GitLab")
System_Ext(cicd, "CI/CD System", "Jenkins / GitHub Actions")
System_Ext(objectStorage, "Object Storage", "AWS S3 / GCS / Azure Blob")
System_Ext(idp, "Identity Provider", "Okta / GitHub OAuth")

Rel(frontend, catalogPlugin, "GET /catalog/entities, etc.", "JSON/HTTPS")
Rel(frontend, scaffolderPlugin, "POST /scaffolder/v2/tasks, etc.", "JSON/HTTPS")
Rel(frontend, authPlugin, "GET /auth/<provider>/start, etc.", "OAuth2/HTTPS")
Rel(frontend, techdocsPlugin, "GET /techdocs/static/...", "JSON/HTTPS")
Rel(frontend, searchPlugin, "GET /search/query", "JSON/HTTPS")

Rel(catalogPlugin, backendSystem, "Resolves: DatabaseService,\nLoggerService, CacheService,\nConfigService", "In-process DI")
Rel(scaffolderPlugin, backendSystem, "Resolves: DatabaseService,\nLoggerService, ConfigService", "In-process DI")
Rel(authPlugin, backendSystem, "Resolves: LoggerService,\nConfigService, TokenManager", "In-process DI")
Rel(techdocsPlugin, backendSystem, "Resolves: LoggerService,\nConfigService", "In-process DI")
Rel(searchPlugin, backendSystem, "Resolves: DatabaseService,\nLoggerService, CacheService", "In-process DI")
Rel(permissionPlugin, backendSystem, "Resolves: LoggerService,\nConfigService", "In-process DI")

Rel(searchPlugin, catalogPlugin, "Fetches entity documents\nfor indexing via CatalogApi", "In-process HTTP / CatalogClient")
Rel(scaffolderPlugin, catalogPlugin, "Reads Template entities\nvia CatalogApi", "In-process HTTP / CatalogClient")
Rel(permissionPlugin, catalogPlugin, "Resolves entity ownership\nfor policy evaluation", "In-process HTTP / CatalogClient")
Rel(permissionPlugin, scaffolderPlugin, "Evaluates scaffolder\ntask permissions", "In-process HTTP")

Rel(catalogPlugin, postgres, "Reads/writes entity records,\nrelations, refresh state", "SQL/TCP via Knex")
Rel(scaffolderPlugin, postgres, "Persists task state and logs", "SQL/TCP via Knex")
Rel(authPlugin, postgres, "Persists session tokens", "SQL/TCP via Knex")
Rel(searchPlugin, postgres, "Persists Lunr search index", "SQL/TCP via Knex")

Rel(catalogPlugin, redis, "Caches entity lookups\n(plugin-namespaced)", "Keyv/TCP")
Rel(searchPlugin, redis, "Caches frequent queries\n(plugin-namespaced)", "Keyv/TCP")

Rel(catalogPlugin, sourceControl, "Reads catalog-info.yaml files\n(Discovery Providers)", "REST API/HTTPS")
Rel(scaffolderPlugin, sourceControl, "Creates, pushes repos\n(Scaffolder Actions)", "REST API/HTTPS")
Rel(catalogPlugin, cicd, "Fetches build & pipeline\nstatus for entities", "REST API/HTTPS")
Rel(techdocsPlugin, objectStorage, "Reads/writes generated\nHTML TechDocs assets", "REST API/HTTPS")
Rel(authPlugin, idp, "Authenticates users,\nresolves group membership", "OAuth2/HTTPS")

@enduml
