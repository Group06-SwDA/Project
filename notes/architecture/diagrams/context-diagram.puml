@startuml
!include <c4/C4_Context.puml>
LAYOUT_WITH_LEGEND()
title [Level 1 - System Context] Backstage

Person(developer, "Developer", "Browses catalog, scaffolds projects, reads TechDocs.")
Person(platform_eng, "Platform Engineer", "Configures and extends the portal.")
Person(eng_manager, "Engineering Manager", "Monitors service ownership and team structure.")

System(backstage, "Backstage", "Unified developer portal for software catalog, documentation, and project scaffolding.")

System_Ext(source_control, "Source Control", "GitHub / GitLab / Bitbucket.")
System_Ext(cicd, "CI/CD System", "CircleCI / GitHub Actions / Jenkins.")
System_Ext(cloud_infra, "Cloud Infrastructure", "Kubernetes / AWS / GCP.")
System_Ext(idp, "Identity Provider", "Okta / Auth0 / Google / GitHub.")
System_Ext(object_storage, "Object Storage", "AWS S3 / GCS / Azure Blob.")

Rel(developer, backstage, "Browses catalog, scaffolds projects, reads docs", "HTTPS")
Rel(platform_eng, backstage, "Installs plugins and configures system", "HTTPS / CLI")
Rel(eng_manager, backstage, "Monitors teams and services", "HTTPS")

Rel(backstage, source_control, "Reads catalog-info.yaml, creates repositories", "REST API / HTTPS")
Rel(backstage, cicd, "Fetches build and pipeline status", "REST API / HTTPS")
Rel(backstage, cloud_infra, "Queries cluster state", "REST API / HTTPS")
Rel(backstage, idp, "Authenticates users and resolves groups", "OAuth2 / HTTPS")
Rel(backstage, object_storage, "Stores and reads generated TechDocs assets", "REST API / HTTPS")
@enduml
