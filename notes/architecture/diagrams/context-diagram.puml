@startuml
!include <c4/C4_Context.puml>
LAYOUT_WITH_LEGEND()
title [Level 1 - System Context Diagram] Backstage

Person(developer, "Developer", "Owns services and reads docs.")
Person(platform_eng, "Platform Engineer", "Configures plugins and integrations.")
Person(eng_manager, "Engineering Manager", "Tracks ownership and service health.")

System(backstage, "Backstage", "Developer portal for catalog, docs, and templates.")

System_Ext(source_control, "Source Control", "Hosts code and catalog descriptors.")
System_Ext(cicd, "CI/CD System", "Runs build and deployment pipelines.")
System_Ext(cloud_infra, "Cloud Infrastructure", "Runs services and workloads.")
System_Ext(idp, "Identity Provider", "Authenticates users and groups.")
System_Ext(object_storage, "Object Storage", "Stores generated TechDocs assets.")

Rel(developer, backstage, "Uses portal features", "HTTPS")
Rel(platform_eng, backstage, "Configures the portal", "HTTPS / CLI")
Rel(eng_manager, backstage, "Reviews ownership and health", "HTTPS")

Rel(backstage, source_control, "Reads catalog files, creates repos", "REST API / HTTPS")
Rel(backstage, cicd, "Reads pipeline status", "REST API / HTTPS")
Rel(backstage, cloud_infra, "Queries cluster state", "REST API / HTTPS")
Rel(backstage, idp, "Authenticates users", "OAuth2 / HTTPS")
Rel(backstage, object_storage, "Reads/writes TechDocs assets", "REST API / HTTPS")
@enduml
