@startuml component-diagram-frontend
!include <c4/C4_Component.puml>

LAYOUT_WITH_LEGEND()

title Component Diagram for Backstage - Frontend SPA

Container_Boundary(frontend, "Frontend SPA [React, TypeScript]") {

    Component(appShell, "App Shell", "React / @backstage/app-defaults\n@backstage/core-app-api", "Top-level composition root of\nthe frontend. Declares all\ninstalled plugins, registers\nroutes, mounts the sidebar,\nprovides the theme, and\ncreates the ApiRegistry.")

    Component(apiRegistry, "ApiRegistry\n/ Utility APIs", "TypeScript\n@backstage/core-plugin-api\nApiProvider", "Frontend DI container.\nHolds singleton API instances\n(CatalogApi, ScaffolderApi,\nIdentityApi, SearchApi, etc.).\nPlugins consume APIs through\nthe useApi(ref) hook, never\nimporting implementations\ndirectly - Dependency\nInversion on the frontend.")

    Component(identityAuth, "Auth / Identity UI", "React\n@backstage/plugin-auth-react\n@backstage/core-app-api", "Renders the sign-in page,\nmanages the OAuth redirect\nflow, stores the Backstage\ntoken in memory, and exposes\nIdentityApi to all consumers.\nEach OAuth provider has\na swappable SignInPage.")

    Component(catalogUI, "Catalog UI Plugin", "React\n@backstage/plugin-catalog", "CatalogIndexPage: filterable\nentity table. EntityPage:\ncard-based entity detail\nview with EntitySwitch to\nselect layout by entity kind.\nAll data fetched via CatalogApi.")

    Component(scaffolderUI, "Scaffolder UI Plugin", "React\n@backstage/plugin-scaffolder", "TemplatePage: lists available\nSoftware Templates. TemplateWizard:\nmulti-step form built from\nJSON-schema parameters.\nTaskPage: streams live log\noutput. Calls ScaffolderApi.")

    Component(techdocsUI, "TechDocs UI Plugin", "React\n@backstage/plugin-techdocs", "TechDocsIndexPage: lists\ndocumented entities.\nTechDocsReaderPage: renders\nMkDocs HTML assets inside\nan iframe with a navigation\nsidebar and search. Fetches\nassets from the TechDocs\nbackend via TechDocsStorageApi.")

    Component(searchUI, "Search UI Plugin", "React\n@backstage/plugin-search-react\n@backstage/plugin-search", "GlobalSearchModal: keyboard-\nshortcut-activated overlay.\nSearchBar: debounced input.\nSearchResultList: renders\nresult cards by type.\nCalls SearchApi. Result\ncards are registered by\nother plugins (Catalog, TechDocs).")

    Component(permissionUI, "Permission Framework\n(frontend)", "TypeScript\n@backstage/plugin-permission-react", "RequirePermission HOC and\nusePermission hook. Gates\nUI element rendering based\non permission decisions.\nNot a security boundary -\nbackend plugins must enforce\npermissions independently.\nConsumed by Catalog UI and\nScaffolder UI.")

    Component(coreComponents, "Core Component Library", "React\n@backstage/core-components", "Shared, design-system-level\nUI components (Table, InfoCard,\nHeader, Sidebar, Progress,\nEmptyState, etc.) used by\nall plugin UIs. No business\nlogic - pure presentation.")
}

Container(backend, "App Backend", "Node.js, TypeScript", "Hosts Catalog, Scaffolder,\nAuth, TechDocs, Search,\nPermission backend plugins.")

Rel(appShell, apiRegistry, "Creates ApiProvider;\nregisters all API\nimplementations at startup", "In-process / React context")
Rel(appShell, identityAuth, "Mounts SignInPage;\ninitialises and registers\nIdentityApi implementation", "React render tree")
Rel(appShell, catalogUI, "Mounts /catalog routes", "React Router")
Rel(appShell, scaffolderUI, "Mounts /create routes", "React Router")
Rel(appShell, techdocsUI, "Mounts /docs routes", "React Router")
Rel(appShell, searchUI, "Mounts /search routes;\nregisters modal in App", "React Router / React render tree")
Rel(appShell, permissionUI, "Registers PermissionApi\nimplementation", "In-process / React context")
Rel(appShell, coreComponents, "Provides theme tokens\nand layout primitives", "React context / component props")

Rel(catalogUI, apiRegistry, "useApi(catalogApiRef)\nuseApi(starredEntitiesApiRef)", "React hook")
Rel(scaffolderUI, apiRegistry, "useApi(scaffolderApiRef)", "React hook")
Rel(techdocsUI, apiRegistry, "useApi(techdocsStorageApiRef)", "React hook")
Rel(searchUI, apiRegistry, "useApi(searchApiRef)", "React hook")
Rel(permissionUI, apiRegistry, "useApi(permissionApiRef)", "React hook")

Rel(catalogUI, coreComponents, "Uses Table, InfoCard,\nHeader, etc.", "React component imports")
Rel(scaffolderUI, coreComponents, "Uses Stepper, Progress,\nInfoCard, etc.", "React component imports")
Rel(techdocsUI, coreComponents, "Uses Header, SupportButton", "React component imports")
Rel(searchUI, coreComponents, "Uses Table, EmptyState", "React component imports")

Rel(catalogUI, techdocsUI, "EntityTechdocsContent card\nembeds TechDocs Reader\non the EntityPage", "React extension/component composition")
Rel(catalogUI, permissionUI, "usePermission gates\nedit/delete actions\nper entity", "React hook")
Rel(scaffolderUI, permissionUI, "usePermission gates\ntemplate execution", "React hook")

Rel(apiRegistry, backend, "Most plugin API clients forward\nrequests to backend plugin APIs", "JSON/HTTPS")

@enduml
